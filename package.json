{
  "name": "@scxfe/wiki-agent",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "从代码知识图谱生成结构化中文 Markdown Wiki 的 CLI 工具（LLM 增强叙述 + 纯规则回退）",
  "type": "module",
  "bin": {
    "scx-wiki-agent": "./dist/bin.js"
  },
  "packageManager": "pnpm@11.17.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "wiki",
    "documentation",
    "codebase",
    "knowledge-graph",
    "llm",
    "cli"
  ],
  "author": "shawicx",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawicx/scx-wiki-agent.git"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.67",
    "ai": "^6.0.193",
    "commander": "^15.0.0",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
